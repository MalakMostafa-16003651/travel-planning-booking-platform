MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
PORT=3000
FXRATES_API_KEY=<optional-fxratesapi-key-kept-server-side>
STRIPE_SECRET_KEY=<stripe-test-secret-key-sk_test>
STRIPE_WEBHOOK_SECRET=<webhook-signing-secret-whsec-from-stripe-listen>

# Optional ACC-07 password recovery. Leave all SMTP values blank to keep mail disabled.
# Use a development SMTP test inbox; never commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Trusted reset-page URL; HTTPS except loopback HTTP for local development. No query/fragment.
# The M2 client reads #token=... and POSTs the token/newPassword to /api/auth/reset-password.
PASSWORD_RESET_URL=

# Optional ACC-02 email verification. Enable enforcement only after SMTP/URL setup and booking-owner integration.
EMAIL_VERIFICATION_URL=
EMAIL_VERIFICATION_REQUIRED=false
