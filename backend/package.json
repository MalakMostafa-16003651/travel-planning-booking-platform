{
  "name": "travel-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for the Travel Planning and Booking Platform",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:prod": "node dist/main.js",
    "build:test": "tsc -p tsconfig.test.json",
    "seed:currencies": "npm run build && node dist/scripts/seed-currencies.js",
    "seed:admin": "npm run build && node dist/scripts/seed-admin.js",
    "seed:references": "npm run build && node dist/scripts/seed-references.js",
    "test": "npm run build:test && node --test --test-concurrency=1 .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.0.2",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3"
  }
}
