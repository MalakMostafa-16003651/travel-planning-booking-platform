# Server-only fixed upstream. Never use NEXT_PUBLIC_ for private configuration.
BACKEND_URL=http://localhost:3000

# Stripe publishable key (pk_test_... for development). Publishable keys are public by design; the secret
# key and webhook secret live only in backend/.env. Read when `next build` runs. Empty: checkout shows
# "Payments are not configured".
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
