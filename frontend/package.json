  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
