{
  "name": "travel-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3001",
    "build": "next build",
    "start": "next start --hostname localhost --port 3001",
